# ============================================================
# AKMA Business — متغيرات البيئة
# انسخ هذا الملف إلى .env.local واملأ القيم.
# ⚠️ لا تضع أي كلمة مرور أو مفتاح داخل الكود — كل الأسرار هنا فقط.
# ============================================================

# ---------- وضع قاعدة البيانات (SaaS متعدد العملاء) ----------

# رابط PostgreSQL (Neon / Supabase / Vercel Postgres / محلي)
# على Vercel: أضفه من Project → Settings → Environment Variables
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/akma_business?schema=public"

# سر توقيع جلسات الدخول (كوكي HttpOnly) — أنشئ قيمة عشوائية:
#   openssl rand -base64 32
# مطلوب فقط عندما يكون NEXT_PUBLIC_DATA_PROVIDER=api
AUTH_SECRET=""

# "api"  = PostgreSQL عبر Prisma مع عزل المؤسسات (يتطلب DATABASE_URL + AUTH_SECRET)
# (أو احذفه/اتركه فارغًا) = التخزين المحلي في المتصفح (وضع MVP الافتراضي)
NEXT_PUBLIC_DATA_PROVIDER="api"

# ---------- لاحقًا (غير مطلوب حاليًا) ----------
# رابط قاعدة البيانات المباشر للترحيلات (Neon/Prisma pooler):
# DIRECT_URL=""

# بوابة إرسال البريد (اختياري) — لاستعادة كلمة المرور في الإنتاج:
# عنوان ويب يستقبل POST JSON: { to, subject, text, resetUrl }
# بدونه: تُعرض روابط الاستعادة تجريبيًا في وضع التطوير فقط (أبدًا في الإنتاج).
# EMAIL_WEBHOOK_URL=""
