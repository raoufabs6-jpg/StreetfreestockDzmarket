// ============================================================
// AKMA Business — مخطط قاعدة البيانات (PostgreSQL + Prisma 7)
// منصة SaaS متعددة العملاء (Multi-tenant):
//   كل جدول بيانات يحمل organizationId ويُفلتر به في كل استعلام.
// ملاحظات التصميم:
//   - تواريخ الأعمال (YYYY-MM-DD) تُخزَّن نصًا لتجنّب مشاكل المناطق الزمنية.
//   - المبالغ Float (ملائم لـ MVP غير المحاسبي) — يمكن الترقية لـ Decimal لاحقًا.
//   - كلمة المرور تُخزَّن مُجزّأة (scrypt) — لا تُسجل في أي ردّ أو سجل.
// ============================================================

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ------------------------- Enums -------------------------

/// أدوار نظام AKMA — التسلسل: owner > admin > manager > employee
enum role {
  owner
  admin
  manager
  employee
}

enum userStatus {
  active
  invited
  disabled
}

enum productStatus {
  active
  inactive
}

enum unit {
  piece
  kg
  g
  l
  m
  box
}

enum paymentStatus {
  paid
  unpaid
  partial
}

enum invoiceStatus {
  draft
  sent
  paid
  overdue
}

enum expenseCategory {
  rent
  salaries
  utilities
  marketing
  transport
  maintenance
  other
}

enum paymentMethod {
  cash
  bank
  check
}

enum movementType {
  in
  out
  adjust
}

// ------------------------- المؤسسات والمستخدمون -------------------------

/// مؤسسة (Tenant) — وحدة العزل الأساسية: كل بيانات العملاء محصورة بها
model Organization {
  id        String   @id @default(uuid())
  name      String
  /// اسم المنشأة الظاهر في الفواتير/التقارير (يحاكي settings في الواجهة)
  businessName String?
  email     String?
  phone     String?
  address   String?
  currency  String   @default("DZD")
  /// مصفوفة الصلاحيات JSON: { admin: ["dashboard.view", ...], manager: [...] }
  rolePermissions Json?

  /// السماح ببيع أكبر من المخزون المتوفر (طلب مسبق) — يُفحص على الخادم
  allowOversell Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users              User[]
  customers          Customer[]
  suppliers          Supplier[]
  categories         Category[]
  products           Product[]
  inventories        Inventory[]
  inventoryMovements InventoryMovement[]
  sales              Sale[]
  saleItems          SaleItem[]
  purchases          Purchase[]
  purchaseItems      PurchaseItem[]
  invoices           Invoice[]
  invoiceItems       InvoiceItem[]
  expenses           Expense[]
  payments           Payment[]
  notifications      Notification[]
  passwordResetTokens PasswordResetToken[]
  /// اشتراك الخطة (SaaS) — سجل واحد لكل مؤسسة
  subscription       Subscription?

  @@index([createdAt])
}

/// مستخدم داخل مؤسسة — كلمة المرور مُجزّأة ولا تظهر أبدًا في ردود API
model User {
  id             String     @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  name         String
  /// البريد فريد عالميًا في هذا الـ MVP (تسجيل الدخول ببريد + كلمة مرور)
  email        String     @unique
  phone        String?
  /// scrypt: "salt:hash" — لا يُرسل للعميل إطلاقًا
  passwordHash String?
  role         role       @default(employee)
  status       userStatus @default(active)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  notifications Notification[]

  /// إصدار الجلسة — يُرفع عند تغيير كلمة المرور لإبطال كل الجلسات القديمة
  sessionVersion       Int      @default(0)
  passwordResetTokens  PasswordResetToken[]

  @@index([organizationId])
  @@index([organizationId, role])
}

/// رموز استعادة كلمة المرور — تُخزَّن مُجزّأة (SHA-256) وتنتهي بعد 30 دقيقة
model PasswordResetToken {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// SHA-256 للرمز الخام — الرمز الأصلي لا يُخزَّن أبدًا
  tokenHash String
  expiresAt DateTime
  usedAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tokenHash])
  @@index([organizationId])
  @@index([userId])
}

// ------------------------- CRM -------------------------

model Customer {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  name    String
  email   String?
  phone   String?
  address String?
  note    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sales    Sale[]
  invoices Invoice[]

  @@index([organizationId])
  @@index([organizationId, name])
}

model Supplier {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  name        String
  contactName String?
  email       String?
  phone       String?
  address     String?
  note        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  purchases Purchase[]

  @@index([organizationId])
  @@index([organizationId, name])
}

// ------------------------- المنتجات والمخزون -------------------------

model Category {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  name String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products Product[]

  @@unique([organizationId, name])
  @@index([organizationId])
}

model Product {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  name        String
  /// SKU فريد داخل نفس المؤسسة (القيمة الفارغة تُحوَّل إلى null)
  sku         String?
  unit        unit     @default(piece)
  costPrice   Float    @default(0)
  unitPrice   Float    @default(0)
  /// حد التنبيه — الكمية الفعلية في جدول Inventory
  minStock    Int      @default(0)
  description String?
  /// حالة المنتج — الموقوف لا يظهر في نماذج البيع ولا يمكن بيعه
  status      productStatus @default(active)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  inventory          Inventory?
  inventoryMovements InventoryMovement[]
  saleItems          SaleItem[]
  purchaseItems      PurchaseItem[]

  @@unique([organizationId, sku])
  @@index([organizationId])
  @@index([organizationId, name])
}

/// مستوى المخزون الحالي لكل منتج (سجل واحد لكل منتج داخل المؤسسة)
model Inventory {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  productId String  @unique
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  quantity Int      @default(0)
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  @@index([organizationId])
}

/// سجل حركات المخزون (يغذّي صفحة "حركات المخزون" في الواجهة)
model InventoryMovement {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  productId String
  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  type     movementType
  quantity Int
  date     String // YYYY-MM-DD
  note     String?

  /// مرجع المستند الذي أنشأ الحركة (بيع/شراء) — أعمدة تاريخية فقط (بدون FK)
  /// حتى يبقى سجل الحركات كاملًا بعد حذف المستند، وتُحسب حركات الإلغاء
  /// من الحركات المرتبطة فقط (منع تعديل خاطئ للمخزون عند الحذف)
  saleId     String?
  purchaseId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId, date])
  @@index([organizationId, productId])
  @@index([saleId])
  @@index([purchaseId])
}

// ------------------------- المبيعات والمشتريات -------------------------

model Sale {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)

  number         String
  date           String // YYYY-MM-DD
  discount       Float        @default(0)
  paymentStatus  paymentStatus @default(unpaid)
  note           String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items SaleItem[]

  @@unique([organizationId, number])
  @@index([organizationId, date])
}

model SaleItem {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  saleId String
  sale   Sale   @relation(fields: [saleId], references: [id], onDelete: Cascade)

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  quantity Int
  price    Float

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId, saleId])
  @@index([organizationId, productId])
}

model Purchase {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  supplierId String
  supplier   Supplier @relation(fields: [supplierId], references: [id], onDelete: Restrict)

  number        String
  date          String // YYYY-MM-DD
  discount      Float         @default(0)
  paymentStatus paymentStatus @default(unpaid)
  note          String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items PurchaseItem[]

  @@unique([organizationId, number])
  @@index([organizationId, date])
}

model PurchaseItem {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  purchaseId String
  purchase   Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  quantity Int
  price    Float

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId, purchaseId])
  @@index([organizationId, productId])
}

// ------------------------- الفواتير والمصاريف والمدفوعات -------------------------

model Invoice {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)

  number String
  date   String // YYYY-MM-DD
  dueDate String // YYYY-MM-DD
  amount Float
  status invoiceStatus @default(draft)
  /// حالة الدفع المالية: paid / partial / unpaid
  paymentStatus paymentStatus @default(unpaid)
  discount      Float         @default(0)

  /// البيع المصدر للفاتورة (لقطة) — أعمدة بدون FK: الفاتورة تبقى بعد حذف البيع
  saleId     String?
  saleNumber String?

  items InvoiceItem[]
  note   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  payments Payment[]

  @@unique([organizationId, number])
  @@index([organizationId, date])
  @@index([organizationId, status])
  @@index([organizationId, saleId])
}

/// بنود الفاتورة — لقطة مستقلة (اسم المنتج مُنسوخ عند الإصدار)
model InvoiceItem {
  id             String  @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  invoiceId String
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  /// بدون FK — يبقى سجل الفاتورة كاملًا حتى لو حُذف المنتج
  productId String?
  /// اسم المنتج وقت إصدار الفاتورة (لقطة ثابتة)
  name      String
  quantity  Int
  price     Float

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId, invoiceId])
}

model Expense {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  date          String // YYYY-MM-DD
  category      expenseCategory
  amount        Float
  description   String
  paymentMethod paymentMethod @default(cash)
  note          String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId, date])
  @@index([organizationId, category])
}

/// دفعة مرتبطة بفاتورة (بنية جاهزة لوحدة الدفع لاحقًا)
model Payment {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  invoiceId String?
  invoice   Invoice? @relation(fields: [invoiceId], references: [id], onDelete: SetNull)

  amount       Float
  date         String // YYYY-MM-DD
  method       paymentMethod @default(cash)
  note         String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId, date])
  @@index([organizationId, invoiceId])
}

// ------------------------- الإشعارات -------------------------

model Notification {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  /// المستخدم المستلم (null = لجميع أعضاء المؤسسة)
  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  type  String // مثال: low_stock | unpaid_invoice
  title String
  body  String?
  link  String?
  read  Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId, read])
  @@index([organizationId, createdAt])
}

/* =================== اشتراكات SaaS (الخطط) =================== */

enum plan {
  free
  basic
  business
  pro
}

enum subscriptionStatus {
  trial
  active
  expired
  cancelled
}

/// اشتراك مؤسسة بخطة واحدة — سجل واحد فريد لكل مؤسسة.
/// بدون بوابة دفع في هذه المرحلة: التجربة تبدأ تلقائيًا،
/// والخطط المدفوعة بعد انتهاء التجربة تُرفض لحين ربط Stripe.
model Subscription {
  id             String       @id @default(uuid())
  organizationId String       @unique
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  plan   plan               @default(business)
  status subscriptionStatus @default(trial)

  /// متى بدأت التجربة المجانية (مرة واحدة لكل مؤسسة)
  trialUsedAt DateTime?
  /// نهاية فترة التجربة
  trialEndsAt  DateTime?
  /// بداية الدورة المدفوعة — تُملأ عند تفعيل بوابة دفع لاحقًا (Stripe)
  currentPeriodStart DateTime?
  /// نهاية الدورة المدفوعة — تُملأ عند تفعيل بوابة دفع لاحقًا (Stripe)
  currentPeriodEnd DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
